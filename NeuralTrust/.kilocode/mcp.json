{
    "mcpServers": {
        "dart-mcp-server": {
            "command": "dart",
            "args": [
                "mcp-server"
            ],
            "env": {},
            "disabled": false
        },
        "firebase-mcp-server": {
            "command": "npx",
            "args": [
                "-y",
                "firebase-tools@latest",
                "mcp"
            ],
            "env": {},
            "disabled": false
        }
    }
}